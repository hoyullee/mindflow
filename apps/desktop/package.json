{
  "name": "@mindflow/desktop",
  "productName": "Geurio",
  "version": "0.2.0",
  "private": true,
  "description": "마인드맵, 화이트보드, 칸반 보드. 지금 하는 일에 맞는 방식으로 생각을 정리하고 함께 완성하세요.",
  "main": "dist/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "start": "pnpm run compile && electron .",
    "pack": "pnpm run compile && electron-builder --publish never",
    "pack:win": "pnpm run compile && electron-builder --win --publish never",
    "pack:mac": "pnpm run compile && electron-builder --mac --publish never",
    "pack:appx": "pnpm run compile && electron-builder --win appx --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:icon": "node scripts/generate-desktop-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "vitest": "^2.1.8"
  },
  "author": "Geurio"
}
